                <string notr="true">QTableWidget { 
	gridline-color: rgba(80, 22, 22, 0);
	min-height: 50px;
}

QTableWidget::item {
	color: rgb(80, 61, 61);
	background-color: rgba(200, 183, 183, 150);
}

QTableWidget::item:selected{
	background-color: rgb(182, 82, 93);
	selection-color: rgb(80, 22, 22);
}

QScrollBar:vertical {
	background-color: rgba(0,0,0,0);
	border: none;
	width: 24px;
	margin:  40px 0 0 0;
	border-radius: 0px;
}

QScrollBar::handle:vertical {
	background-color: rgb(200, 183, 183);
	border-radius: 9px;
	min-height: 30px;
	margin: 3px;
}

QScrollBar::handle:vertical:pressed {
	background-color: rgb(182, 82, 93);
}

QScrollBar::sub-line:vertical {
	background-color: none;
}

QScrollBar::add-line:vertical {
	background-color: none;
}</string>
